<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- EMO Logo / Title -->
    <TextView
        android:id="@+id/setupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMO SETUP"
        android:textColor="#00FFD1"
        android:textSize="32sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/setupSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant permissions for full device control"
        android:textColor="#66FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp" />

    <!-- Step indicator -->
    <TextView
        android:id="@+id/stepIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 1 / 5"
        android:textColor="#00FFD1"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <!-- Step title -->
    <TextView
        android:id="@+id/stepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set EMO as Home Screen"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Step description -->
    <TextView
        android:id="@+id/stepDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EMO needs to be your default home screen so it stays active at all times."
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp" />

    <!-- Status (granted / not granted) -->
    <TextView
        android:id="@+id/stepStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● NOT GRANTED"
        android:textColor="#FF4444"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <!-- Action button -->
    <Button
        android:id="@+id/btnGrant"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:text="GRANT"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:backgroundTint="#00FFD1"
        android:layout_marginBottom="16dp" />

    <!-- Skip button -->
    <Button
        android:id="@+id/btnSkip"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:text="SKIP"
        android:textColor="#66FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:backgroundTint="#1A1A1A" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Progress dots -->
    <LinearLayout
        android:id="@+id/progressDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <View android:id="@+id/dot1" android:layout_width="10dp" android:layout_height="10dp"
            android:background="#00FFD1" android:layout_margin="4dp" />
        <View android:id="@+id/dot2" android:layout_width="10dp" android:layout_height="10dp"
            android:background="#333333" android:layout_margin="4dp" />
        <View android:id="@+id/dot3" android:layout_width="10dp" android:layout_height="10dp"
            android:background="#333333" android:layout_margin="4dp" />
        <View android:id="@+id/dot4" android:layout_width="10dp" android:layout_height="10dp"
            android:background="#333333" android:layout_margin="4dp" />
        <View android:id="@+id/dot5" android:layout_width="10dp" android:layout_height="10dp"
            android:background="#333333" android:layout_margin="4dp" />
    </LinearLayout>

</LinearLayout>
