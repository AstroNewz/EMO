<?xml version="1.0" encoding="utf-8"?>
<!-- Pure Native Android Taskmagotchi Layout — Zero WebView/Chrome -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- CENTER STAGE: Pure Native Pixelated LED Face View -->
    <com.emo.launcher.view.EmoPixelFaceView
        android:id="@+id/pixelFaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP BAR: Tamagotchi Status Meters -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#0DFFFFFF"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHappyMeter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HAPPY ❤️ 100%"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvEnergyMeter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ENERGY ⚡ 95%"
                android:textColor="#00FFD1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTasksMeter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TASKS 📋 0/3"
                android:textColor="#FFB800"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SPEECH BUBBLE DIALOG CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/speechBubbleCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomBar"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#F20F0F0F"
        app:strokeColor="#4D00FFD1"
        app:strokeWidth="1dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSpeechText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi Boss! I'm EMO, your AI buddy. Tap anywhere or talk to me!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvStatusSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMO ONLINE · TAP TO TALK"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTTOM BAR: Chat Input & Terminal Swipe Button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="#1AFFFFFF"
                android:hint="Talk to EMO or add task..."
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#00FFD1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSwipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲ TAP FOR TERMINAL OVERLAY ▲"
            android:textColor="#4DFFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace" />
    </LinearLayout>

</RelativeLayout>
